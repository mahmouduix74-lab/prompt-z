{
  "name": "promptz",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:client": "vite build",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "cf:dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:ci": "node scripts/cf-deploy.mjs deploy",
    "preview:ci": "node scripts/cf-deploy.mjs preview"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@react-stately/utils": "^3.12.1",
    "@untitledui/file-icons": "^0.0.9",
    "@untitledui/icons": "^0.0.23",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-react-aria-components": "^2.2.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "wrangler": "^4.136.0"
  }
}
